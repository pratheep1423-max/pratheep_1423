# ============================================================
# 2M Pictures — Environment Variables Reference
# Copy this file as .env for local development
# Set these in Railway Dashboard > Variables for production
# ============================================================

# Backend Server Port (Railway sets this automatically)
PORT=5000

# Admin Login Credentials
ADMIN_EMAIL=admin@2mpictures.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pratheep@217

# Frontend API URL (Set to your Railway backend URL after deploy)
# Example: VITE_API_URL=https://2m-pictures-backend.up.railway.app/api
VITE_API_URL=http://localhost:5000/api
